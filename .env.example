# Copia este archivo a .env.local para desarrollar.
# En Vercel, crea las mismas variables en Project Settings → Environment Variables.
# No pongas claves reales en el repositorio.

# --- Obligatorias en producción (Vercel + Neon) ---
# Cadena pooled de Neon, la que incluye "-pooler" en el host.
# Ejemplo: postgres://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Primer administrador. Solo se usa si la base todavía no tiene usuarios.
# La contraseña debe tener al menos 10 caracteres.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Secreto largo y aleatorio. Vercel Cron envía Authorization: Bearer <CRON_SECRET>.
# También lo usa un cron externo si quieres pulsos más frecuentes en el plan gratis.
CRON_SECRET=

# URL pública sin barra final. En local: http://localhost:3000
# En Vercel: https://tu-proyecto.vercel.app
# Tiene que coincidir con el origen que registres en Google.
APP_URL=http://localhost:3000

# --- Google OAuth (opcional) ---
# El botón «Continuar con Google» se ve siempre. Sin estas dos variables queda desactivado
# y la API dice "Inicio con Google no configurado". El flujo usa state y PKCE (S256).
# Redirect de producción: https://pikas.vercel.app/api/auth/google/callback
# Guía: docs/DESPLIEGUE.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Correos que pueden entrar con Google aunque no tengan invitación, separados por comas.
GOOGLE_ALLOWED_EMAILS=
# Si es false, una cuenta nueva de Google puede crearse sin invitación.
# Por defecto la invitación sigue siendo obligatoria.
INVITE_REQUIRED=true

# Horas de Madrid de las rondas unidas. Se pueden cambiar.
# PIKAS_TZ=Europe/Madrid
# SESSION_ASIA=02:00
# SESSION_LONDON=09:00
# SESSION_NEWYORK=15:30
# SESSION_DURATION_MIN=240
# SESSION_VOTE_LEAD_MIN=480
# PIKAS_RONDA_SYMBOL=BTC

# --- PIKAS AI (opcional) ---
# Sin ninguna de estas variables, el chat dice "PIKAS AI no configurado".
# El usuario nunca ve qué motor respondió. El orden y las claves están en docs/DESPLIEGUE.md.
# Los de pago solo entran si AI_ALLOW_PAID=true.
GEMINI_API_KEY=
GEMINI_MODEL_CHEAP=gemini-3.6-flash
GEMINI_MODEL_STRONG=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL_CHEAP=openai/gpt-oss-20b
GROQ_MODEL_STRONG=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL_CHEAP=openrouter/free
OPENROUTER_MODEL_STRONG=openrouter/free
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL_CHEAP=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_MODEL_STRONG=@cf/meta/llama-3.1-8b-instruct
HF_TOKEN=
# SambaNova Cloud, capa gratuita sin tarjeta (tope diario). https://cloud.sambanova.ai
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL_CHEAP=Meta-Llama-3.3-70B-Instruct
SAMBANOVA_MODEL_STRONG=Meta-Llama-3.3-70B-Instruct
# NVIDIA NIM, prototipo gratis con tope de peticiones. https://build.nvidia.com/settings
NVIDIA_API_KEY=
NVIDIA_MODEL_CHEAP=meta/llama-3.1-8b-instruct
NVIDIA_MODEL_STRONG=meta/llama-3.3-70b-instruct
HF_MODEL_CHEAP=Qwen/Qwen2.5-7B-Instruct
HF_MODEL_STRONG=Qwen/Qwen2.5-7B-Instruct
MISTRAL_API_KEY=
MISTRAL_MODEL_CHEAP=mistral-small-latest
MISTRAL_MODEL_STRONG=mistral-small-latest
# Ollama solo si el servidor puede alcanzar esta URL. En Vercel, localhost no sirve.
OLLAMA_BASE_URL=
OLLAMA_MODEL_CHEAP=llama3.2
OLLAMA_MODEL_STRONG=llama3.2
# Cerebras no es un plan gratis permanente: pide tarjeta para un crédito de prueba.
CEREBRAS_API_KEY=
CEREBRAS_MODEL_CHEAP=gpt-oss-120b
CEREBRAS_MODEL_STRONG=gpt-oss-120b
# De pago. Déjalo en false para no generar coste.
AI_ALLOW_PAID=false
AI_PAID_DAILY_BUDGET_USD=0
OPENAI_API_KEY=
OPENAI_MODEL_CHEAP=gpt-4o-mini
OPENAI_MODEL_STRONG=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CHEAP=claude-3-5-haiku-latest
ANTHROPIC_MODEL_STRONG=claude-sonnet-4-5
XAI_API_KEY=
XAI_MODEL_CHEAP=grok-3-mini
XAI_MODEL_STRONG=grok-3
AI_DAILY_BUDGET_USD=1
AI_MONTHLY_BUDGET_USD=10
AI_MAX_OUTPUT_TOKENS=800

# --- Opcionales ---
# true exige invitación para el registro con contraseña. Déjalo así.
INVITE_REQUIRED=true
# Clave demo de CoinGecko. No hace falta: el precio funciona sin ella.
COINGECKO_API_KEY=
# Solo cámbiala si también redespliegas: el middleware la lee en el build.
SESSION_COOKIE_NAME=pikas_session

# --- Solo en tu ordenador ---
# Sin DATABASE_URL, el desarrollo usa Postgres embebido en esta carpeta.
PIKAS_DATA_DIR=.data/pglite
